Before:
  let g:path_token_hits = []
  source plugin/src.vim

After:
  unlet! g:path_token_hits
  call src#end()
  call src#end()


Execute (Quoted <cword> is treated as a literal filename, not the current-word token):
  let g:path_token_hits = []
  " Created at runtime: the filename is invalid on Windows checkouts.
  let root = tempname()
  call mkdir(root, 'p')
  call writefile([
    \ 'let g:path_token_hits = get(g:, ''path_token_hits'', [])',
    \ 'call add(g:path_token_hits, ''literal-cword'')',
    \ ], root . '/<cword>')
  call writefile([
    \ 'let g:path_token_hits = get(g:, ''path_token_hits'', [])',
    \ 'call add(g:path_token_hits, ''wordtarget'')',
    \ ], root . '/wordtarget')
  enew
  call setline(1, ['wordtarget'])
  normal! gg0
  call src#begin(root)
  try
    call src#('<cword>')
  finally
    call src#end()
    call delete(root, 'rf')
  endtry

Then:
  AssertEqual ['literal-cword'], g:path_token_hits
