Before:
  let g:path_token_hits = []
  source plugin/src.vim

After:
  unlet! g:path_token_hits
  call src#end()
  call src#end()


Execute (Quoted <cword> is treated as a literal filename, not the current-word token):
  let g:path_token_hits = []
  let root = getcwd() . '/tests/fixtures/path-token-expansion'
  enew
  call setline(1, ['wordtarget'])
  normal! gg0
  call src#begin(root)
  call src#('<cword>')
  call src#end()

Then:
  AssertEqual ['literal-cword'], g:path_token_hits
