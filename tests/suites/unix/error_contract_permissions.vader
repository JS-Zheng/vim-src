Before:
  source autoload/src.vim
  source tests/lib/test_helper.vim

After:
  unlet! g:caught
  unlet! g:src_unreadable_child_hit
  unlet! g:src_readable_child_hit


Execute (Src throws a stable not-found error for a broken symlink target):
  let root = getcwd() .. '/tests/.tmp/error-contract-broken-symlink'
  call delete(root, 'rf')
  call mkdir(root, 'p')
  call system('ln -s missing-target ' .. root .. '/broken')
  let error = ''
  call src#begin(root)
  try
    Src 'broken'
  catch
    let error = v:exception
  finally
    call src#end()
    call delete(root, 'rf')
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'


Execute (A listable directory without search permission is unreadable):
  let root = tempname()
  call mkdir(root, 'p')
  call writefile(['let g:src_permission_probe = 1'], root .. '/child.vim')
  call SrcTestSetUnixMode(root, '400')
  let error = ''
  try
    call src#(root)
  catch
    let error = v:exception
  finally
    call SrcTestSetUnixMode(root, '700')
    call delete(root, 'rf')
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'


Execute (An empty searchable directory without read permission is unreadable):
  let root = tempname()
  call mkdir(root, 'p')
  call SrcTestSetUnixMode(root, '100')
  let error = ''
  try
    call src#(root)
  catch
    let error = v:exception
  finally
    call SrcTestSetUnixMode(root, '700')
    call delete(root, 'rf')
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'


Execute (call src#('broken') throws a stable not-found error for a broken symlink target):
  let root = getcwd() .. '/tests/.tmp/error-contract-broken-symlink-call'
  call delete(root, 'rf')
  call mkdir(root, 'p')
  call system('ln -s missing-target ' .. root .. '/broken')
  let error = ''
  call src#begin(root)
  try
    call src#('broken')
  catch
    let error = v:exception
  finally
    call src#end()
    call delete(root, 'rf')
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'


Execute (Src throws a stable unreadable file error):
  let root = getcwd() .. '/tests/.tmp/error-contract-unreadable-file'
  call delete(root, 'rf')
  call writefile(['" test'], root)
  call SrcTestMakeUnreadable(root, 'file')
  let error = ''
  try
    call src#(root)
  catch
    let error = v:exception
  finally
    call SrcTestRestoreReadable(root, 'file')
    call delete(root)
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'


Execute (Src throws a stable unreadable directory error):
  let root = getcwd() .. '/tests/.tmp/error-contract-unreadable-dir'
  call delete(root, 'rf')
  call mkdir(root, 'p')
  call SrcTestMakeUnreadable(root, 'dir')
  let error = ''
  try
    call src#(root)
  catch
    let error = v:exception
  finally
    call SrcTestRestoreReadable(root, 'dir')
    call delete(root, 'd')
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'


Execute (An unreadable directory child is an invalid target):
  let root = tempname()
  call mkdir(root, 'p')
  call writefile(['let g:src_unreadable_child_hit = 1'], root .. '/child.vim')
  call SrcTestSetUnixMode(root .. '/child.vim', '000')
  let error = ''
  try
    call src#(root)
  catch
    let error = v:exception
  finally
    call SrcTestSetUnixMode(root .. '/child.vim', '600')
    call delete(root, 'rf')
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'
  Assert !exists('g:src_unreadable_child_hit')


Execute (Optional directory loading skips an unreadable child):
  let root = tempname()
  call mkdir(root, 'p')
  call writefile(['let g:src_unreadable_child_hit = 1'], root .. '/10-unreadable.vim')
  call writefile(['let g:src_readable_child_hit = 1'], root .. '/20-readable.vim')
  call SrcTestSetUnixMode(root .. '/10-unreadable.vim', '000')
  try
    call src#(root, 1)
  finally
    call SrcTestSetUnixMode(root .. '/10-unreadable.vim', '600')
    call delete(root, 'rf')
  endtry

Then:
  Assert !exists('g:src_unreadable_child_hit')
  AssertEqual 1, g:src_readable_child_hit
