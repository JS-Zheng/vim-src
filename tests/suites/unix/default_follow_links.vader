Before:
  source plugin/src.vim
  source tests/lib/test_helper.vim

After:
  call src#end()
  unlet! g:src


Execute (follow_links defaults to 1 for an explicit symlinked file target):
  let root = getcwd() .. '/tests/.tmp/default-follow-links-file-target'
  let real = root .. '/real'
  let link = root .. '/alias-file.vim'
  let g:src_follow_links_hits = []

  call delete(root, 'rf')
  call mkdir(real, 'p')
  call writefile(["let g:src_follow_links_hits = ['linked-file-default']"], real .. '/target.vim')
  call system('ln -s ' .. shellescape('real/target.vim') .. ' ' .. shellescape(link))

  try
    let g:src = {}
    call src#begin(root)
    Src 'alias-file.vim'
    call src#end()
  finally
    call delete(root, 'rf')
  endtry

Then:
  AssertEqual ['linked-file-default'], g:src_follow_links_hits


Execute (src#begin() without an explicit option falls back to the global follow_links setting):
  let root = getcwd() .. '/tests/.tmp/default-follow-links-global-fallback'
  let real = root .. '/real-root'
  let denied = real .. '/denied'
  let alias = root .. '/alias-root'
  let error = ''

  call delete(root, 'rf')
  call mkdir(denied, 'p')
  call system('ln -s ' .. shellescape('real-root') .. ' ' .. shellescape(alias))
  call SrcTestMakeUnreadable(denied, 'dir')

  try
    let g:src = {'follow_links': 1}
    try
      call src#begin(alias)
      call src#('denied')
    catch
      let error = v:exception
    finally
      call src#end()
    endtry
  finally
    call SrcTestRestoreReadable(denied, 'dir')
    call delete(root, 'rf')
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'
