Execute (src#begin() follow_links option overrides a disabled global follow_links setting):
  let root = getcwd() .. '/tests/.tmp/resolve-links-begin-local-on'
  let real = root .. '/real-root'
  let denied = real .. '/denied'
  let alias = root .. '/alias-root'
  let error = ''

  call delete(root, 'rf')
  call mkdir(denied, 'p')
  call system('ln -s ' .. shellescape('real-root') .. ' ' .. shellescape(alias))
  call SrcTestMakeUnreadable(denied, 'dir')

  try
    let g:src = {'follow_links': 0}
    try
      call src#begin(alias, {'follow_links': 1})
      call src#('denied')
    catch
      let error = v:exception
    finally
      call src#end()
    endtry
  finally
    call SrcTestRestoreReadable(denied, 'dir')
    call delete(root, 'rf')
    unlet! g:src
  endtry

Then:
  Assert error =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'
  Assert error =~# real
  Assert error !~# alias


