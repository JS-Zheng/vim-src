Before:
  source plugin/src.vim
  source tests/lib/test_helper.vim

After:
  call src#end()
  call src#end()
  unlet! g:src


Execute (`follow_links` changes the resolved unreadable-directory path):
  " Tests that Enabling follow_links (the default) causes resolution errors to
  " report the physical (real) path, while disabling it reports the logical
  " (alias) path.

  let root = getcwd() .. '/tests/.tmp/resolve-links'
  let real = root .. '/real-root'
  let denied = real .. '/denied'
  let alias = root .. '/alias-root'
  let errors = []

  call delete(root, 'rf')
  call mkdir(denied, 'p')
  call system('ln -s ' .. shellescape('real-root') .. ' ' .. shellescape(alias))
  call SrcTestMakeUnreadable(denied, 'dir')

  try
    for flag in [0, 1]
      let g:src = {'follow_links': flag}
      try
        call src#begin(alias)
        call src#('denied')
      catch
        call add(errors, v:exception)
      finally
        call src#end()
      endtry
    endfor
  finally
    call SrcTestRestoreReadable(denied, 'dir')
    call delete(root, 'rf')
  endtry

Then:
  AssertEqual 2, len(errors)
  Assert errors[0] =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'
  Assert errors[0] =~# alias
  Assert errors[0] !~# real

  Assert errors[1] =~# '^src: ' .. g:src#ERR_INVALID_TARGET .. ':'
  Assert errors[1] =~# real
  Assert errors[1] !~# alias


