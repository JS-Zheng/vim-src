Before:
  source autoload/src.vim
  source tests/lib/test_helper.vim


Execute (Unix candidates follow official Vim order):
  let candidates = SrcTestInitCandidates('unix', '/home/alice', '/home/alice/.config')

Then:
  AssertEqual '/home/alice/.vimrc', candidates[0].vimrc
  AssertEqual '/home/alice/.vim', candidates[0].config_home
  AssertEqual '/home/alice/.vim/vimrc', candidates[1].vimrc
  AssertEqual '/home/alice/_vimrc', candidates[2].vimrc
  AssertEqual '/home/alice/.config/vim/vimrc', candidates[3].vimrc


Execute (Windows candidates prefer HOME before VIM):
  " Validates platform-specific discovery logic for Windows, ensuring
  " user-local home configurations are prioritized over system-wide
  " installations.

  let candidates = SrcTestInitCandidates('windows', 'C:/Users/Alice', 'C:/Program Files/Vim')

Then:
  AssertEqual 'C:\Users\Alice\_vimrc', candidates[0].vimrc
  AssertEqual 'C:\Users\Alice\vimfiles', candidates[0].config_home
  AssertEqual 'C:\Users\Alice\vimfiles\vimrc', candidates[1].vimrc
  AssertEqual 'C:\Users\Alice\.vimrc', candidates[2].vimrc
  AssertEqual 'C:\Program Files\Vim\_vimrc', candidates[3].vimrc


Execute (Windows vimrc maps to vimfiles config home):
  " Verifies the Windows-specific mapping logic where a _vimrc or .vimrc file
  " correctly resolves to a 'vimfiles' directory context.

  let config_home = SrcTestConfigHomeFromVimrc('windows', 'C:\Program Files\Vim\_vimrc', 'C:/Users/Alice', 'C:/Program Files/Vim')

Then:
  AssertEqual 'C:\Program Files\Vim\vimfiles', config_home


Execute (Unix XDG vimrc maps to XDG vim config home):
  let config_home = SrcTestConfigHomeFromVimrc('unix', '/home/alice/.config/vim/vimrc', '/home/alice', '/home/alice/.config')

Then:
  AssertEqual '/home/alice/.config/vim', config_home
