Execute (Default base dir falls back to $VIMRUNTIME in named mode):
  let $HOME = getcwd() . '/tests/fixtures/default-base/empty-home'
  let $XDG_CONFIG_HOME = ''
  let $MYVIMRC = ''
  let $VIM = ''
  let $VIMRUNTIME = getcwd() . '/tests/fixtures/default-base/vimruntime'
  let g:src_default_base_hits = []
  call src#begin()
  Src 'default.vim'
  call src#end()

Then:
  AssertEqual ['vimruntime'], g:src_default_base_hits


Execute (Canonical default base dir falls back to $VIM/vimfiles in Vim):
  " Neovim canonical mode always considers stdpath('config') first, and that
  " root is not reliably redirectable mid-session. This fallback contract is
  " therefore only testable in Vim.
  if has('nvim')
    let g:src_default_base_hits = ['nvim-skip']
  else
    let $HOME = getcwd() . '/tests/fixtures/default-base/empty-home'
    let $XDG_CONFIG_HOME = ''
    let $MYVIMRC = ''
    let $VIM = getcwd() . '/tests/fixtures/default-base/vim'
    let $VIMRUNTIME = ''
    let g:src = {'base_name': ''}
    let g:src_default_base_hits = []
    call src#begin()
    Src 'default.vim'
    call src#end()
    let g:src = {}
  endif

Then:
  if has('nvim')
    AssertEqual ['nvim-skip'], g:src_default_base_hits
  else
    AssertEqual ['vim-canonical'], g:src_default_base_hits
  endif


Execute (Default base dir expands ~/... in explicit override mode):
  let $HOME = getcwd() . '/tests/fixtures/default-base/home'
  let $XDG_CONFIG_HOME = ''
  let $MYVIMRC = ''
  let $VIM = ''
  let $VIMRUNTIME = ''
  let g:src = {'base_dir': '~/.vim/vimrcs'}
  let g:src_default_base_hits = []
  call src#begin()
  Src 'default.vim'
  call src#end()
  let g:src = {}

Then:
  AssertEqual ['home'], g:src_default_base_hits


Execute (Default base dir reports a configured directory removed after use):
  let base = tempname()
  call mkdir(base, 'p')
  call writefile(["call add(g:src_default_base_hits, 'temp-base')"], base . '/default.vim')
  let g:src = {'base_dir': base}
  call src#('default.vim')
  call delete(base, 'rf')
  let error = ''
  try
    call src#('default.vim', 1)
  catch
    let error = v:exception
  endtry
  let g:src = {}

Then:
  AssertEqual ['temp-base'], g:src_default_base_hits
  Assert error =~# '^src: ' .. g:src#ERR_RESOLUTION .. ':', error
