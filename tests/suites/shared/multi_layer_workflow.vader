Before:
  let g:src_test_save_home = exists('$HOME') ? $HOME : ''
  let g:src_test_save_xdg = exists('$XDG_CONFIG_HOME') ? $XDG_CONFIG_HOME : ''
  let g:src_test_save_myvimrc = exists('$MYVIMRC') ? $MYVIMRC : ''
  let g:multi_layer_workflow_hits = []
  if exists(':Src') == 2
    delcommand Src
  endif
  unlet! g:src
  source autoload/src.vim

After:
  let $HOME = g:src_test_save_home
  let $XDG_CONFIG_HOME = g:src_test_save_xdg
  let $MYVIMRC = g:src_test_save_myvimrc
  unlet! g:multi_layer_workflow_hits
  unlet! g:src_test_save_home
  unlet! g:src_test_save_xdg
  unlet! g:src_test_save_myvimrc
  call src#end()
  call src#end()
  call src#end()
  unlet! g:src


Execute (Official workflow supports mixed plain Src and nested src#begin usage):
  " Tests the combination of standard relative sourcing and explicit
  " sub-scoping, ensuring that nested scopes do not disrupt the path tracking
  " of the parent loader.

  let $HOME = getcwd() . '/tests/fixtures/multi-layer-workflow/home'
  let $XDG_CONFIG_HOME = ''
  let $MYVIMRC = $HOME . '/.vimrc'
  let g:multi_layer_workflow_hits = []
  call src#init()
  Src 'main.vim'

Then:
  AssertEqual [
        \ 'main-start',
        \ 'leaf-top',
        \ '10-layer-root',
        \ '15-child-no-begin',
        \ '20-deeper',
        \ '30-after-deeper',
        \ 'main-end',
        \ ], g:multi_layer_workflow_hits


Execute (Directory-expanded scripts can mix plain relative loads and nested begin calls):
  let $HOME = getcwd() . '/tests/fixtures/multi-layer-workflow/home'
  let $XDG_CONFIG_HOME = ''
  let $MYVIMRC = $HOME . '/.vimrc'
  let g:multi_layer_workflow_hits = []
  call src#init()
  Src 'collections'

Then:
  AssertEqual [
        \ '10-collection-root',
        \ '11-collection-leaf',
        \ '20-collection-begin',
        \ '21-collection-deep',
        \ '22-collection-after',
        \ ], g:multi_layer_workflow_hits


Execute (Nested src#begin scopes unwind back to the immediate parent scope):
  let $HOME = getcwd() . '/tests/fixtures/multi-layer-workflow/home'
  let $XDG_CONFIG_HOME = ''
  let $MYVIMRC = $HOME . '/.vimrc'
  let g:multi_layer_workflow_hits = []
  call src#init()
  Src 'scoped_parent.vim'

Then:
  AssertEqual [
        \ '10-parent',
        \ '20-child',
        \ '30-grandchild',
        \ '40-after-grandchild',
        \ '50-after-child',
        \ ], g:multi_layer_workflow_hits


Execute (Directory-expanded siblings keep their own loading context after another sibling used src#begin()):
  let $HOME = getcwd() . '/tests/fixtures/multi-layer-workflow/home'
  let $XDG_CONFIG_HOME = ''
  let $MYVIMRC = $HOME . '/.vimrc'
  let g:multi_layer_workflow_hits = []
  call src#init()
  Src 'sibling-groups'

Then:
  AssertEqual [
        \ '10-sibling-begin',
        \ '11-sibling-deep',
        \ '20-sibling-plain',
        \ '21-sibling-plain-child',
        \ ], g:multi_layer_workflow_hits
